# Version of Elastic products
STACK_VERSION=8.19.18

# Set the cluster name
CLUSTER_NAME=siemids-cluster

# Set to 'basic' or 'trial' to automatically start the 30-day trial
LICENSE=basic
#LICENSE=trial

# Port to expose Elasticsearch HTTP API to the host
ES_PORT=9200
#ES_PORT=127.0.0.1:9200

# Port to expose Kibana to the host
KIBANA_PORT=5601
#KIBANA_PORT=80

# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824

# Project namespace (defaults to the current folder name if not set)
COMPOSE_PROJECT_NAME=siemids

# This host's LAN IP, added to the elasticsearch cert's SAN list so remote
# Beats agents (e.g. a Suricata sensor on a separate host) can connect with
# full TLS hostname verification instead of failing on IP mismatch. Only
# takes effect on first cert generation (see setup_pki) -- delete certs/ and
# rerun ./start.sh if you change this after certs already exist.
ELK_LAN_IP=192.168.1.100
