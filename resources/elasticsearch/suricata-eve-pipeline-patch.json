{
  "description": "Pipeline for parsing Suricata EVE logs",
  "processors": [
    {
      "set": {
        "field": "event.ingested",
        "value": "{{_ingest.timestamp}}"
      }
    },
    {
      "rename": {
        "target_field": "destination.mac",
        "ignore_missing": true,
        "field": "suricata.eve.ether.dest_mac"
      }
    },
    {
      "rename": {
        "target_field": "source.mac",
        "ignore_missing": true,
        "field": "suricata.eve.ether.src_mac"
      }
    },
    {
      "lowercase": {
        "ignore_missing": true,
        "field": "suricata.eve.event_type"
      }
    },
    {
      "script": {
        "lang": "painless",
        "ignore_failure": true,
        "params": {
          "tftp": {
            "type": [
              "protocol"
            ],
            "network_protocol": "tftp"
          },
          "rdp": {
            "type": [
              "protocol"
            ],
            "network_protocol": "rdp"
          },
          "mqtt": {
            "network_protocol": "mqtt",
            "type": [
              "protocol"
            ]
          },
          "rfb": {
            "type": [
              "protocol"
            ],
            "network_protocol": "rdp"
          },
          "dns": {
            "type": [
              "protocol"
            ],
            "network_protocol": "dns"
          },
          "ftp": {
            "network_protocol": "ftp",
            "type": [
              "protocol"
            ]
          },
          "ssh": {
            "network_protocol": "ssh",
            "type": [
              "protocol"
            ]
          },
          "flow": {
            "type": [
              "connection"
            ]
          },
          "alert": {
            "kind": "alert",
            "category": [
              "network",
              "intrusion_detection"
            ]
          },
          "smb": {
            "type": [
              "protocol"
            ],
            "network_protocol": "smb"
          },
          "ftp_data": {
            "type": [
              "protocol"
            ],
            "network_protocol": "ftp"
          },
          "tls": {
            "network_protocol": "tls",
            "type": [
              "protocol"
            ]
          },
          "stats": {
            "kind": "metric"
          },
          "http2": {
            "category": [
              "network",
              "web"
            ],
            "type": [
              "access",
              "protocol"
            ],
            "network_protocol": "http"
          },
          "http": {
            "network_protocol": "http",
            "category": [
              "network",
              "web"
            ],
            "type": [
              "access",
              "protocol"
            ]
          }
        },
        "source": "ctx.event.kind = 'event';\nctx.event.category = ['network'];\ndef type_params = params.get(ctx?.suricata?.eve?.event_type);\nif (type_params == null) {\n    return;\n}\ntype_params.forEach((k, v) -> {\n    if ('network_protocol' == k) {\n        if (ctx.network == null) {\n            ctx.network = ['protocol': v];\n        } else {\n            ctx.network.protocol = v;\n        }\n    } else if (v instanceof List) {\n        ctx.event[k] = new ArrayList(v);\n    } else {\n        ctx.event[k] = v;\n    }\n});\n",
        "tag": "suricata_ecs_categorize"
      }
    },
    {
      "lowercase": {
        "ignore_missing": true,
        "field": "suricata.eve.app_proto"
      }
    },
    {
      "set": {
        "if": "ctx?.suricata?.eve?.app_proto == \"ftp-data\"",
        "field": "network.protocol",
        "value": "ftp"
      }
    },
    {
      "set": {
        "ignore_empty_value": true,
        "if": "ctx?.suricata?.eve?.app_proto != \"failed\" && ctx?.suricata?.eve?.app_proto != \"template\" && ctx?.suricata?.eve?.app_proto != \"template-rust\"",
        "field": "network.protocol",
        "value": "{{suricata.eve.app_proto}}"
      }
    },
    {
      "set": {
        "if": "ctx?.suricata?.eve?.event_type == \"http\" && ctx?.suricata?.eve?.http?.status != null && ctx?.suricata?.eve?.http?.status < 400",
        "field": "event.outcome",
        "value": "success"
      }
    },
    {
      "set": {
        "value": "failure",
        "if": "ctx?.suricata?.eve?.event_type == \"http\" && ctx?.suricata?.eve?.http?.status != null && ctx?.suricata?.eve?.http?.status >= 400",
        "field": "event.outcome"
      }
    },
    {
      "pipeline": {
        "if": "ctx?.network?.protocol == \"dns\"",
        "name": "filebeat-8.17.4-suricata-eve-dns"
      }
    },
    {
      "pipeline": {
        "if": "ctx?.network?.protocol == \"tls\"",
        "name": "filebeat-8.17.4-suricata-eve-tls"
      }
    },
    {
      "pipeline": {
        "if": "ctx?.network?.protocol == \"http\"",
        "name": "filebeat-8.17.4-suricata-eve-http"
      }
    },
    {
      "append": {
        "if": "ctx?.suricata?.eve?.flow?.state == \"new\"",
        "field": "event.type",
        "value": [
          "start"
        ]
      }
    },
    {
      "append": {
        "value": [
          "end"
        ],
        "if": "ctx?.suricata?.eve?.flow?.state == \"closed\"",
        "field": "event.type"
      }
    },
    {
      "script": {
        "ignore_failure": true,
        "lang": "painless",
        "tag": "suricata_deduplicate_dest_domain",
        "source": "def domain = ctx.destination?.domain; if (domain instanceof Collection) {\n  domain = domain.stream().distinct().collect(Collectors.toList());\n  if (domain.length == 1) {\n    domain = domain[0];\n  }\n  ctx.destination.domain = domain;\n}\n"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.fileinfo.filename",
        "target_field": "file.path"
      }
    },
    {
      "rename": {
        "target_field": "file.size",
        "ignore_missing": true,
        "field": "suricata.eve.fileinfo.size"
      }
    },
    {
      "lowercase": {
        "field": "network.transport",
        "ignore_missing": true
      }
    },
    {
      "convert": {
        "target_field": "message",
        "type": "string",
        "ignore_missing": true,
        "field": "suricata.eve.alert.category"
      }
    },
    {
      "set": {
        "field": "rule.category",
        "value": "{{suricata.eve.alert.category}}",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "field": "rule.id",
        "value": "{{suricata.eve.alert.signature_id}}",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "field": "rule.name",
        "value": "{{suricata.eve.alert.signature}}",
        "ignore_empty_value": true
      }
    },
    {
      "set": {
        "if": "ctx?.suricata?.eve?.alert?.action == 'blocked'",
        "field": "suricata.eve.alert.action",
        "value": "denied"
      }
    },
    {
      "append": {
        "value": "{{suricata.eve.alert.action}}",
        "if": "ctx?.suricata?.eve?.alert?.action != null",
        "field": "event.type"
      }
    },
    {
      "remove": {
        "ignore_failure": true,
        "field": "suricata.eve.alert.action"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.severity",
        "target_field": "event.severity",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.protocols",
        "target_field": "suricata.eve.alert.protocols"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.attack_target",
        "target_field": "suricata.eve.alert.attack_target",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.capec_id",
        "target_field": "suricata.eve.alert.capec_id",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.cwe_id",
        "target_field": "suricata.eve.alert.cwe_id",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "target_field": "suricata.eve.alert.malware",
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.malware"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.cve",
        "target_field": "suricata.eve.alert.cve"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.cvss_v2_base",
        "target_field": "suricata.eve.alert.cvss_v2_base",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "target_field": "suricata.eve.alert.cvss_v2_temporal",
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.cvss_v2_temporal"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.cvss_v3_base",
        "target_field": "suricata.eve.alert.cvss_v3_base",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.cvss_v3_temporal",
        "target_field": "suricata.eve.alert.cvss_v3_temporal",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "target_field": "suricata.eve.alert.priority",
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.priority"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.hostile",
        "target_field": "suricata.eve.alert.hostile"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.infected",
        "target_field": "suricata.eve.alert.infected",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.created_at",
        "target_field": "_tmp_.created_at",
        "ignore_missing": true
      }
    },
    {
      "join": {
        "field": "_tmp_.created_at",
        "description": "Converts date field to string",
        "separator": ",",
        "if": "ctx._tmp_?.created_at != null"
      }
    },
    {
      "date": {
        "if": "ctx._tmp_?.created_at != null",
        "ignore_failure": true,
        "field": "_tmp_.created_at",
        "target_field": "suricata.eve.alert.created_at",
        "formats": [
          "yyyy-MM-dd",
          "yyyy_MM_dd"
        ]
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.updated_at",
        "target_field": "_tmp_.updated_at",
        "ignore_missing": true
      }
    },
    {
      "join": {
        "description": "Converts date field to string",
        "separator": ",",
        "if": "ctx._tmp_?.updated_at != null",
        "field": "_tmp_.updated_at"
      }
    },
    {
      "date": {
        "target_field": "suricata.eve.alert.updated_at",
        "formats": [
          "yyyy-MM-dd",
          "yyyy_MM_dd"
        ],
        "if": "ctx._tmp_?.updated_at != null",
        "ignore_failure": true,
        "field": "_tmp_.updated_at"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.filename",
        "target_field": "file.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.classtype",
        "target_field": "suricata.eve.alert.classtype",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.rule_source",
        "target_field": "suricata.eve.alert.rule_source"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.sid",
        "target_field": "suricata.eve.alert.sid",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "target_field": "threat.tactic.id",
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.mitre_attack"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.mitre_tactic_id",
        "target_field": "threat.tactic.id",
        "ignore_missing": true,
        "if": "ctx.threat?.tactic?.id == null"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.mitre_tactic_name",
        "target_field": "threat.tactic.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "suricata.eve.alert.metadata.mitre_technique_id",
        "target_field": "threat.technique.id",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.alert.metadata.mitre_technique_id",
        "target_field": "threat.technique.name"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.flow.pkts_toclient",
        "target_field": "destination.packets"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.flow.pkts_toserver",
        "target_field": "source.packets"
      }
    },
    {
      "rename": {
        "field": "suricata.eve.flow.bytes_toclient",
        "target_field": "destination.bytes",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "suricata.eve.flow.bytes_toserver",
        "target_field": "source.bytes"
      }
    },
    {
      "script": {
        "tag": "suricata_network_bytes_packets",
        "lang": "painless",
        "source": "long getOrZero(def map, def key) {\n  if (map!=null && map[key]!=null) {\n    return map[key];\n  }\n  return 0;\n} def network=ctx['network'], source=ctx['source'], dest=ctx['destination']; def sp=getOrZero(source,'packets'), sb=getOrZero(source,'bytes'), dp=getOrZero(dest,'packets'), db=getOrZero(dest,'bytes'); if (sb+db+sp+dp > 0) {\n  if (network == null) {\n    network=new HashMap();\n    ctx['network']=network;\n  }\n  if (sb+db > 0) {\n    network['bytes'] = sb+db;\n  }\n  if(sp+dp>0) {\n    network['packets'] = sp+dp;\n  }\n}\n"
      }
    },
    {
      "date": {
        "field": "suricata.eve.flow.start",
        "target_field": "event.start",
        "formats": [
          "ISO8601"
        ],
        "ignore_failure": true
      }
    },
    {
      "date": {
        "field": "suricata.eve.flow.end",
        "target_field": "event.end",
        "formats": [
          "ISO8601"
        ],
        "ignore_failure": true
      }
    },
    {
      "script": {
        "lang": "painless",
        "source": "Instant ins(def d) {\n  try {\n    return Instant.parse(d);\n  } catch(Exception e) {\n    return null;\n  }\n} def ev = ctx['event']; if (ev != null) {\n  def start = ins(ev['start']);\n  def end = ins(ev['end']);\n  if (start != null && end != null && !start.isAfter(end)) {\n    ev['duration'] = Duration.between(start,end).toNanos();\n  }\n}\n",
        "tag": "suricata_event_duration"
      }
    },
    {
      "lowercase": {
        "field": "suricata.eve.proto",
        "target_field": "network.transport",
        "ignore_missing": true
      }
    },
    {
      "enrich": {
        "description": "Local/VPN/PIA network geo lookup for source.ip -- replaces Filebeat client-side add_fields (see filebeat-raspberrysrv.yml git history)",
        "policy_name": "net-geo-cidr",
        "field": "source.ip",
        "target_field": "_geo_enrich_src",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_src != null",
        "field": "source.geo",
        "copy_from": "_geo_enrich_src.geo"
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_src != null && ctx._geo_enrich_src.as != null",
        "field": "source.as.organization.name",
        "copy_from": "_geo_enrich_src.as.organization.name"
      }
    },
    {
      "set": {
        "description": "destination.ip exact match for the two dnsmasq_pia-related DNS IPs -- NOT folded into the net-geo-cidr range policy below, since 192.168.100.200 overlaps with the 192.168.100.0/24 localnet range and Elasticsearch's range enrich policy does not reliably prefer the more specific match on overlap (confirmed via _simulate). Exact match takes priority; falls back to the CIDR policy otherwise.",
        "if": "(ctx.destination?.ip == '192.168.100.200' || ctx.destination?.ip == '10.0.0.243')",
        "field": "_geo_lookup_key_dst_exact",
        "value": "piavpn"
      }
    },
    {
      "enrich": {
        "if": "ctx._geo_lookup_key_dst_exact == 'piavpn'",
        "policy_name": "net-geo-profile",
        "field": "_geo_lookup_key_dst_exact",
        "target_field": "_geo_enrich_dst_exact",
        "ignore_missing": true
      }
    },
    {
      "enrich": {
        "description": "Local/VPN/PIA network geo lookup for destination.ip (non-overlapping ranges only -- see the exact-match step above for the two PIA DNS IPs)",
        "policy_name": "net-geo-cidr",
        "field": "destination.ip",
        "target_field": "_geo_enrich_dst",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_dst_exact != null",
        "field": "destination.geo",
        "copy_from": "_geo_enrich_dst_exact.geo"
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_dst_exact == null && ctx._geo_enrich_dst != null",
        "field": "destination.geo",
        "copy_from": "_geo_enrich_dst.geo"
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_dst_exact != null",
        "field": "destination.as.organization.name",
        "copy_from": "_geo_enrich_dst_exact.as.organization.name"
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_dst_exact == null && ctx._geo_enrich_dst != null && ctx._geo_enrich_dst.as != null",
        "field": "destination.as.organization.name",
        "copy_from": "_geo_enrich_dst.as.organization.name"
      }
    },
    {
      "set": {
        "description": "vpn_hop.source: reuse the localnet geo already resolved above for wlan0/wlan1 AP clients and the 192.168.100.10 gateway-override host -- narrower than 'profile == localnet' (excludes the rest of 192.168.100.0/24, e.g. the router's own uplink)",
        "if": "ctx.source?.ip != null && (ctx.source.ip.startsWith('10.10.10.') || ctx.source.ip.startsWith('10.1.1.') || ctx.source.ip == '192.168.100.10') && ctx._geo_enrich_src != null",
        "field": "vpn_hop.source.geo.location",
        "copy_from": "_geo_enrich_src.geo.location"
      }
    },
    {
      "set": {
        "if": "ctx.source?.ip != null && (ctx.source.ip.startsWith('10.10.10.') || ctx.source.ip.startsWith('10.1.1.') || ctx.source.ip == '192.168.100.10')",
        "field": "_geo_lookup_key",
        "value": "vpnet"
      }
    },
    {
      "enrich": {
        "description": "vpn_hop.destination: constant lookup of vpnet's current exit geo, regardless of this document's real destination.ip",
        "if": "ctx._geo_lookup_key == 'vpnet'",
        "policy_name": "net-geo-profile",
        "field": "_geo_lookup_key",
        "target_field": "_geo_enrich_vpnet",
        "ignore_missing": true
      }
    },
    {
      "set": {
        "if": "ctx._geo_enrich_vpnet != null",
        "field": "vpn_hop.destination.geo.location",
        "copy_from": "_geo_enrich_vpnet.geo.location"
      }
    },
    {
      "set": {
        "description": "pia_dns_hop: local client's DNS query routed via dnsmasq_pia/PIA's own upstream resolver -- both sides reuse geo already resolved above",
        "if": "ctx._geo_enrich_src != null && ctx._geo_enrich_src.profile == 'localnet' && (ctx.destination?.ip == '192.168.100.200' || ctx.destination?.ip == '10.0.0.243')",
        "field": "pia_dns_hop.source.geo.location",
        "copy_from": "_geo_enrich_src.geo.location"
      }
    },
    {
      "set": {
        "description": "pia_dns_hop.destination reuses the exact-match result (not the CIDR fallback) -- this condition implies pia_dns_ips_cond, which is exactly what populated _geo_enrich_dst_exact above",
        "if": "ctx._geo_enrich_src != null && ctx._geo_enrich_src.profile == 'localnet' && ctx._geo_enrich_dst_exact != null && (ctx.destination?.ip == '192.168.100.200' || ctx.destination?.ip == '10.0.0.243')",
        "field": "pia_dns_hop.destination.geo.location",
        "copy_from": "_geo_enrich_dst_exact.geo.location"
      }
    },
    {
      "geoip": {
        "if": "ctx?.source?.geo == null",
        "field": "source.ip",
        "target_field": "source.geo",
        "ignore_missing": true
      }
    },
    {
      "geoip": {
        "target_field": "destination.geo",
        "ignore_missing": true,
        "if": "ctx?.destination?.geo == null",
        "field": "destination.ip"
      }
    },
    {
      "geoip": {
        "database_file": "GeoLite2-ASN.mmdb",
        "field": "source.ip",
        "target_field": "source.as",
        "properties": [
          "asn",
          "organization_name"
        ],
        "ignore_missing": true
      }
    },
    {
      "geoip": {
        "database_file": "GeoLite2-ASN.mmdb",
        "field": "destination.ip",
        "target_field": "destination.as",
        "properties": [
          "asn",
          "organization_name"
        ],
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "source.as.asn",
        "target_field": "source.as.number",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "source.as.organization_name",
        "target_field": "source.as.organization.name",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "destination.as.asn",
        "target_field": "destination.as.number",
        "ignore_missing": true
      }
    },
    {
      "rename": {
        "field": "destination.as.organization_name",
        "target_field": "destination.as.organization.name",
        "ignore_missing": true
      }
    },
    {
      "append": {
        "if": "ctx?.url?.domain != null && ctx.url.domain != ''",
        "field": "related.hosts",
        "value": "{{url.domain}}",
        "allow_duplicates": false
      }
    },
    {
      "append": {
        "if": "ctx?.source?.ip != null",
        "field": "related.ip",
        "value": "{{source.ip}}",
        "allow_duplicates": false
      }
    },
    {
      "append": {
        "value": "{{destination.ip}}",
        "allow_duplicates": false,
        "if": "ctx?.destination?.ip != null",
        "field": "related.ip"
      }
    },
    {
      "remove": {
        "field": [
          "suricata.eve.app_proto",
          "suricata.eve.flow.end",
          "suricata.eve.flow.start",
          "suricata.eve.http.http_method",
          "suricata.eve.http.http_user_agent",
          "_tmp_",
          "_geo_enrich_src",
          "_geo_enrich_dst",
          "_geo_lookup_key",
          "_geo_enrich_vpnet",
          "_geo_lookup_key_dst_exact",
          "_geo_enrich_dst_exact"
        ],
        "ignore_missing": true
      }
    }
  ],
  "on_failure": [
    {
      "append": {
        "field": "error.message",
        "value": "error in [{{_ingest.on_failure_processor_type}}] processor{{#_ingest.on_failure_processor_tag}} with tag [{{_ingest.on_failure_processor_tag }}]{{/_ingest.on_failure_processor_tag}} {{ _ingest.on_failure_message }}"
      }
    },
    {
      "remove": {
        "field": [
          "suricata.eve.alert.action",
          "suricata.eve.alert.severity",
          "suricata.eve.app_proto",
          "suricata.eve.dest_ip",
          "suricata.eve.dest_port",
          "suricata.eve.fileinfo.filename",
          "suricata.eve.fileinfo.size",
          "suricata.eve.flow.bytes_toclient",
          "suricata.eve.flow.bytes_toserver",
          "suricata.eve.flow.pkts_toclient",
          "suricata.eve.flow.pkts_toserver",
          "suricata.eve.flow.start",
          "suricata.eve.http.hostname",
          "suricata.eve.http.http_method",
          "suricata.eve.http.http_refer",
          "suricata.eve.http.http_user_agent",
          "suricata.eve.http.length",
          "suricata.eve.http.status",
          "suricata.eve.http.url",
          "suricata.eve.proto",
          "suricata.eve.src_ip",
          "suricata.eve.src_port",
          "_tmp_"
        ],
        "ignore_missing": true
      }
    }
  ]
}
