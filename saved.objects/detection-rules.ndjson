{"id":"2ce21027-0074-47ed-ab33-f573ca287715","updated_at":"2026-07-19T16:12:09.124Z","updated_by":"elastic","created_at":"2026-07-19T16:12:09.124Z","created_by":"elastic","name":"Potential Internal Linux SSH Brute Force Detected","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Elastic prebuilt rule: 10 SSH auth failures within 15s from the same internal (private-range) source IP and user -- catches a compromised LAN host brute-forcing others.","risk_score":47,"severity":"medium","output_index":"","author":[],"false_positives":[],"from":"now-6m","rule_id":"elastic-ssh-bruteforce-internal","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0006","name":"Credential Access","reference":"https://attack.mitre.org/tactics/TA0006/"},"technique":[{"id":"T1110","name":"Brute Force","reference":"https://attack.mitre.org/techniques/T1110/","subtechnique":[{"id":"T1110.001","name":"Password Guessing","reference":"https://attack.mitre.org/techniques/T1110/001/"},{"id":"T1110.003","name":"Password Spraying","reference":"https://attack.mitre.org/techniques/T1110/003/"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"eql","language":"eql","index":["filebeat-*"],"query":"sequence by host.id, source.ip, user.name with maxspan=15s\n  [ authentication where host.os.type == \"linux\" and \n   event.action in (\"ssh_login\", \"user_login\") and event.outcome == \"failure\" and\n   cidrmatch(source.ip, \"10.0.0.0/8\", \"127.0.0.0/8\", \"169.254.0.0/16\", \"172.16.0.0/12\", \"192.0.0.0/24\",\n       \"192.0.0.0/29\", \"192.0.0.8/32\", \"192.0.0.9/32\", \"192.0.0.10/32\", \"192.0.0.170/32\", \"192.0.0.171/32\",\n       \"192.0.2.0/24\", \"192.31.196.0/24\", \"192.52.193.0/24\", \"192.168.0.0/16\", \"192.88.99.0/24\", \"224.0.0.0/4\",\n       \"100.64.0.0/10\", \"192.175.48.0/24\",\"198.18.0.0/15\", \"198.51.100.0/24\", \"203.0.113.0/24\", \"240.0.0.0/4\", \n       \"::1\", \"FE80::/10\", \"FF00::/8\") ] with runs = 10","actions":[]}
{"id":"277a0bc8-52a0-4f3b-9f21-24e58121aa85","updated_at":"2026-07-19T16:12:10.102Z","updated_by":"elastic","created_at":"2026-07-19T16:12:10.102Z","created_by":"elastic","name":"Linux User Account Creation","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Elastic prebuilt rule: a Linux user account was created via useradd/adduser.","risk_score":21,"severity":"low","output_index":"","author":[],"false_positives":[],"from":"now-6m","rule_id":"elastic-linux-user-creation","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0003","name":"Persistence","reference":"https://attack.mitre.org/tactics/TA0003/"},"technique":[{"id":"T1136","name":"Create Account","reference":"https://attack.mitre.org/techniques/T1136/","subtechnique":[{"id":"T1136.001","name":"Local Account","reference":"https://attack.mitre.org/techniques/T1136/001/"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"eql","language":"eql","index":["filebeat-*"],"query":"iam where host.os.type == \"linux\" and (event.type == \"user\" and event.type == \"creation\") and\nprocess.name in (\"useradd\", \"adduser\") and user.name != null","actions":[]}
{"id":"8c4cc669-eb0e-44ba-9b6c-093f330c614c","updated_at":"2026-07-19T16:12:10.080Z","updated_by":"elastic","created_at":"2026-07-19T16:12:10.080Z","created_by":"elastic","name":"Potential Successful SSH Brute Force Attack","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"Elastic prebuilt rule: 10 SSH auth failures from the same source IP and user, immediately followed by a success -- high-confidence brute-force-then-compromise pattern.","risk_score":73,"severity":"high","output_index":"","author":[],"false_positives":[],"from":"now-6m","rule_id":"elastic-ssh-bruteforce-success","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0006","name":"Credential Access","reference":"https://attack.mitre.org/tactics/TA0006/"},"technique":[{"id":"T1110","name":"Brute Force","reference":"https://attack.mitre.org/techniques/T1110/","subtechnique":[{"id":"T1110.001","name":"Password Guessing","reference":"https://attack.mitre.org/techniques/T1110/001/"},{"id":"T1110.003","name":"Password Spraying","reference":"https://attack.mitre.org/techniques/T1110/003/"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"eql","language":"eql","index":["filebeat-*"],"query":"sequence by host.id, source.ip, user.name with maxspan=15s\n  [authentication where host.os.type == \"linux\" and event.action  in (\"ssh_login\", \"user_login\") and\n   event.outcome == \"failure\" and source.ip != null and source.ip != \"0.0.0.0\" and source.ip != \"::\" ] with runs=10\n\n  [authentication where host.os.type == \"linux\" and event.action  in (\"ssh_login\", \"user_login\") and\n   event.outcome == \"success\" and source.ip != null and source.ip != \"0.0.0.0\" and source.ip != \"::\" ]","actions":[]}
{"id":"1b422d67-92ec-4186-a4db-e0a414b03518","updated_at":"2026-07-19T16:12:11.255Z","updated_by":"elastic","created_at":"2026-07-19T16:12:11.255Z","created_by":"elastic","name":"Sudo used to spawn an interactive shell","tags":[],"interval":"5m","enabled":true,"revision":0,"description":"sudo invoked bash/sh/su/python/perl directly (e.g. \"sudo bash\", \"sudo su\") -- a classic privilege-escalation pattern. Excludes podman exec (this project's own container debugging generates sudo-attributed \"sh\" args constantly). Known expected noise: this project's own start.sh runs \"sudo sh -x scripts/prune.sh\" and \"scripts/pre-podman-launch.sh\" as part of normal deployment -- low volume (~12/24h), safe to dismiss when reviewing.","risk_score":73,"severity":"high","output_index":"","author":[],"false_positives":[],"from":"now-6m","rule_id":"siemids-sudo-interactive-shell","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0004","name":"Privilege Escalation","reference":"https://attack.mitre.org/tactics/TA0004/"},"technique":[{"id":"T1548","name":"Abuse Elevation Control Mechanism","reference":"https://attack.mitre.org/techniques/T1548/","subtechnique":[{"id":"T1548.003","name":"Sudo and Sudo Caching","reference":"https://attack.mitre.org/techniques/T1548/003/"}]}]},{"framework":"MITRE ATT&CK","tactic":{"id":"TA0002","name":"Execution","reference":"https://attack.mitre.org/tactics/TA0002/"},"technique":[{"id":"T1059","name":"Command and Scripting Interpreter","reference":"https://attack.mitre.org/techniques/T1059/","subtechnique":[{"id":"T1059.004","name":"Unix Shell","reference":"https://attack.mitre.org/techniques/T1059/004/"}]}]}],"to":"now","references":[],"version":1,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["filebeat-*"],"query":"event.module:\"auditd\" and event.action:\"ran-command\" and process.executable:\"/usr/bin/sudo\" and process.args:(\"bash\" or \"sh\" or \"su\" or \"python\" or \"python3\" or \"perl\") and not process.args:(\"podman\" or \"exec\")","actions":[]}
{"id":"0ef4e624-f0d7-4c1c-8260-dcb80b97c99b","updated_at":"2026-07-19T16:12:10.123Z","updated_by":"elastic","created_at":"2026-07-19T16:12:10.123Z","created_by":"elastic","name":"Manual firewall rule change (nftables)","tags":[],"interval":"5m","enabled":true,"revision":1,"description":"A netfilter table was loaded/modified outside of the two processes expected to do that automatically -- netavark (Podman's own NAT/isolation, table names prefixed 'netavark') and wg-quick (WireGuard's kill-switch rules, table 'wg-quick-wg0'). This project's own firewall config lives in the 'homelan' table and is only supposed to change via a deliberate 'nft -f /etc/nftables.conf' reload; any other table showing up here (including a resurrected legacy 'filter'/'nat' table from iptables-nft) is worth review. Matches on auditd's raw NETFILTER_CFG table= field rather than process.name:\"nft\", since netavark and wg-quick both invoke the nft binary directly -- a process-name filter alone can't tell their routine churn apart from a manual change.","risk_score":47,"severity":"medium","output_index":"","author":[],"false_positives":[],"from":"now-6m","rule_id":"siemids-manual-firewall-change","max_signals":100,"risk_score_mapping":[],"severity_mapping":[],"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0005","name":"Defense Evasion","reference":"https://attack.mitre.org/tactics/TA0005/"},"technique":[{"id":"T1562","name":"Impair Defenses","reference":"https://attack.mitre.org/techniques/T1562/","subtechnique":[{"id":"T1562.004","name":"Disable or Modify System Firewall","reference":"https://attack.mitre.org/techniques/T1562/004/"}]}]}],"to":"now","references":[],"version":2,"exceptions_list":[],"immutable":false,"rule_source":{"type":"internal"},"related_integrations":[],"required_fields":[],"setup":"","type":"query","language":"kuery","index":["filebeat-*"],"query":"event.module:\"auditd\" and event.action:\"loaded-firewall-rule-to\" and not auditd.data.table:(netavark* or wg-quick-wg0*)","actions":[]}
