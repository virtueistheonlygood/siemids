# Real secrets/credentials -- start.sh appends generated ELASTIC_PASSWORD/
# KIBANA_PASSWORD directly into .env at first run. Never track this file;
# .env.example is the checked-in template. See README.md.
.env

# Generated by scripts/interfaces.py: real interface names, public/VPN IP
# geolocation (lat/lon), and ISP/organization info for this specific
# deployment.
env/*.env
geoip/*.json

# TLS certs/keys generated by the setup_pki service on first ./start.sh run.
certs/

# Operational backups (saved-object exports, config .bak files) -- instance-
# specific, not meant for the public repo.
backups/

# Internal ops runbook/incident log -- real IPs, hostnames, and a running
# session narrative. Not public-facing documentation.
DEPLOYMENT.md
