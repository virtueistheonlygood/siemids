# Real secrets/credentials -- start.sh appends generated ELASTIC_PASSWORD/
# KIBANA_PASSWORD directly into .env at first run. Never track this file;
# .env.example is the checked-in template. See README.md.
.env

# env/elk.env holds the real ELASTICSEARCH_HOSTS/ELASTICSEARCH_PASSWORD used
# by scripts/interfaces.py, refresh-filebeat-enrichment.sh, and
# setup-geo-enrichment.sh to reach Device A's Elasticsearch. geoip/*.json is
# generated by interfaces.py: real interface names, public/VPN IP
# geolocation (lat/lon), and ISP/organization info for this specific
# deployment (also pushed to Elasticsearch's net-geo-source index -- see
# Geo-IP Enrichment for Private-Network Traffic in README.md -- these local
# files are kept only for refresh-filebeat-enrichment.sh's own
# change-detection and debugging history).
env/*.env
geoip/*.json

# TLS certs/keys generated by the setup_pki service on first ./start.sh run.
certs/

# Operational backups (saved-object exports, config .bak files) -- instance-
# specific, not meant for the public repo.
backups/

# Internal ops runbook/incident log -- real IPs, hostnames, and a running
# session narrative. Not public-facing documentation.
DEPLOYMENT.md
